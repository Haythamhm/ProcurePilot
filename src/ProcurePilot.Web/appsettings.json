{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "InvoiceExtractionReview": {
    "ConfidenceThreshold": 0.8,
    "CriticalFields": [
      "InvoiceNumber",
      "SupplierName",
      "PurchaseOrderNumber",
      "InvoiceDate",
      "Currency",
      "TotalAmount"
    ]
  }
}
