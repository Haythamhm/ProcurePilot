{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "Chat": {
      "Provider": "Disabled"
    }
  },
  "ExceptionManagement": {
    "DefaultPriceVarianceSeverity": "Medium"
  },
  "InvoiceExtractionReview": {
    "ConfidenceThreshold": 0.8,
    "CriticalFields": [
      "InvoiceNumber",
      "SupplierName",
      "PurchaseOrderNumber",
      "InvoiceDate",
      "Currency",
      "TotalAmount"
    ]
  }
}
