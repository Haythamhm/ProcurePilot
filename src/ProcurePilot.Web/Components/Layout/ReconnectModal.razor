<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal"
        aria-labelledby="components-reconnect-title"
        aria-describedby="components-reconnect-description"
        data-nosnippet>
    <div class="components-reconnect-container" aria-live="assertive">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-kicker">Secure session</p>
        <h2 id="components-reconnect-title">Connection interrupted</h2>
        <p id="components-reconnect-description" class="components-reconnect-first-attempt-visible">
            Reconnecting to your tenant workspace…
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            The connection is still unavailable. Retrying in <span id="components-seconds-to-next-attempt"></span> seconds.
        </p>
        <p class="components-reconnect-failed-visible">
            Automatic reconnection failed. Retry now or reload the page.
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible" type="button">
            Retry connection
        </button>
        <p class="components-pause-visible">
            Your secure session has been paused by the server.
        </p>
        <p class="components-resume-failed-visible">
            The session could not be resumed. Retry now or reload the page.
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible" type="button">
            Resume session
        </button>
    </div>
</dialog>
