@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <span class="workspace-context">Secure tenant workspace</span>
            <AuthorizeView>
                <Authorized Context="authenticationState">
                    <span class="signed-in-user">
                        <span class="pp-icon-user" aria-hidden="true"></span>
                        <span>@authenticationState.User.Identity?.Name</span>
                    </span>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <strong>Application error.</strong> An unexpected problem occurred.
    <a href="." class="reload">Reload</a>
    <button class="dismiss" type="button" aria-label="Dismiss error">×</button>
</div>
