@inject IJSRuntime JS

<div class="sidebar-wrapper @(IsCollapsed ? "collapsed" : "")">
    <!-- 1. Header with Logo, Title, and Collapse Button -->
    <div class="sidebar-header">
        <a class="brand-link" href="" aria-label="ProcurePilot Accueil" title="ProcurePilot">
            <img src="images/logo.png" class="brand-logo" alt="Logo ProcurePilot" />
            @if (!IsCollapsed)
            {
                <span class="brand-title">ProcurePilot</span>
            }
        </a>

        <button type="button" class="sidebar-collapse-btn @(IsCollapsed ? "collapsed" : "")" @onclick="ToggleCollapse" title="@(IsCollapsed ? "Agrandir le menu" : "Réduire le menu")" aria-label="@(IsCollapsed ? "Agrandir le menu" : "Réduire le menu")">
            <svg class="collapse-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                @if (IsCollapsed)
                {
                    <polyline points="13 17 18 12 13 7"></polyline>
                    <polyline points="6 17 11 12 6 7"></polyline>
                }
                else
                {
                    <polyline points="11 17 6 12 11 7"></polyline>
                    <polyline points="18 17 13 12 18 7"></polyline>
                }
            </svg>
        </button>
    </div>

    <!-- 2. User Profile Card (Wetask/Mockup Style) -->
    <AuthorizeView>
        <Authorized Context="authState">
            <div class="user-card @(IsCollapsed ? "collapsed" : "")" title="@authState.User.Identity?.Name">
                <div class="user-avatar" aria-hidden="true">
                    @(authState.User.Identity?.Name?.Substring(0, 1).ToUpperInvariant() ?? "U")
                </div>
                @if (!IsCollapsed)
                {
                    <div class="user-meta">
                        <span class="user-display-name">@(authState.User.Identity?.Name ?? "Utilisateur")</span>
                        <span class="user-role-label">Administrateur</span>
                    </div>
                    <svg class="user-dropdown-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                }
            </div>
        </Authorized>
    </AuthorizeView>

    <!-- 3. Navigation List (Main Navigation) -->
    <nav class="sidebar-nav" aria-label="Navigation principale">
        <div class="nav-section">
            <div class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Tableau de bord">
                    <span class="nav-icon" aria-hidden="true">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                        </svg>
                    </span>
                    @if (!IsCollapsed)
                    {
                        <span class="nav-label">Tableau de bord</span>
                    }
                </NavLink>
            </div>

            <AuthorizeView>
                <Authorized>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="purchase-orders" title="Bons de commande">
                            <span class="nav-icon" aria-hidden="true">
                                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                    <polyline points="10 9 9 9 8 9"></polyline>
                                </svg>
                            </span>
                            @if (!IsCollapsed)
                            {
                                <span class="nav-label">Bons de commande</span>
                            }
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="work-queue" title="File d'attente (Exceptions)">
                            <span class="nav-icon" aria-hidden="true">
                                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                            </span>
                            @if (!IsCollapsed)
                            {
                                <span class="nav-label">File d'exceptions</span>
                                <span class="nav-badge-pill">3</span>
                            }
                            else
                            {
                                <span class="nav-badge-dot" aria-hidden="true"></span>
                            }
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="invoices/upload" title="Téléverser facture">
                            <span class="nav-icon" aria-hidden="true">
                                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="17 8 12 3 7 8"></polyline>
                                    <line x1="12" y1="3" x2="12" y2="15"></line>
                                </svg>
                            </span>
                            @if (!IsCollapsed)
                            {
                                <span class="nav-label">Upload facture</span>
                            }
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <!-- 4. Projects / Modules Group (Inspired by Mockup) -->
        <AuthorizeView>
            <Authorized>
                <div class="nav-section-projects">
                    @if (!IsCollapsed)
                    {
                        <div class="projects-header">
                            <span class="projects-title">PROJECT</span>
                            <button type="button" class="projects-add-btn" title="Nouveau module" aria-label="Nouveau module">+</button>
                        </div>
                    }

                    <div class="project-item">
                        <NavLink class="project-link" href="work-queue" title="Documentations">
                            <span class="project-dot dot-magenta" aria-hidden="true"></span>
                            @if (!IsCollapsed)
                            {
                                <span class="project-text">Documentations</span>
                            }
                        </NavLink>
                    </div>

                    <div class="project-item">
                        <NavLink class="project-link" href="purchase-orders" title="Commandes actives">
                            <span class="project-dot dot-purple" aria-hidden="true"></span>
                            @if (!IsCollapsed)
                            {
                                <span class="project-text">Commandes actives</span>
                            }
                        </NavLink>
                    </div>

                    <div class="project-item">
                        <NavLink class="project-link" href="invoices/upload" title="Traitement OCR">
                            <span class="project-dot dot-blue" aria-hidden="true"></span>
                            @if (!IsCollapsed)
                            {
                                <span class="project-text">Traitement OCR</span>
                            }
                        </NavLink>
                    </div>

                    <div class="project-item">
                        <NavLink class="project-link" href="work-queue" title="Analyse Écarts">
                            <span class="project-dot dot-coral" aria-hidden="true"></span>
                            @if (!IsCollapsed)
                            {
                                <span class="project-text">Analyse Écarts</span>
                            }
                        </NavLink>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>

    <!-- 5. Bottom Footer with Dark theme toggle, Settings, and Sign out -->
    <div class="sidebar-footer">
        <!-- Theme Toggle Switch -->
        <div class="theme-row @(IsCollapsed ? "collapsed" : "")">
            @if (!IsCollapsed)
            {
                <div class="theme-text-wrap">
                    <svg class="theme-moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                    </svg>
                    <span class="theme-label">Dark theme</span>
                </div>
                <button type="button" class="theme-switch-btn @(_isDark ? "active" : "")" role="switch" aria-checked="@_isDark" @onclick="ToggleThemeAsync" title="@(_isDark ? "Activer mode clair" : "Activer mode sombre")" aria-label="Basculer le thème sombre">
                    <span class="theme-switch-knob"></span>
                </button>
            }
            else
            {
                <button type="button" class="theme-compact-toggle @(_isDark ? "active" : "")" @onclick="ToggleThemeAsync" title="@(_isDark ? "Mode clair" : "Mode sombre")" aria-label="Basculer le thème">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        @if (_isDark)
                        {
                            <circle cx="12" cy="12" r="5"></circle>
                            <line x1="12" y1="1" x2="12" y2="3"></line>
                            <line x1="12" y1="21" x2="12" y2="23"></line>
                        }
                        else
                        {
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                        }
                    </svg>
                </button>
            }
        </div>

        <!-- Settings link -->
        <div class="footer-item">
            <a href="purchase-orders" class="footer-link" title="Paramètres">
                <span class="footer-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                    </svg>
                </span>
                @if (!IsCollapsed)
                {
                    <span class="footer-label">Settings</span>
                }
            </a>
        </div>

        <!-- Sign out link -->
        <AuthorizeView>
            <Authorized>
                <div class="footer-item">
                    <a href="/account/logout" class="footer-link signout-link" title="Se déconnecter">
                        <span class="footer-icon signout-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                        </span>
                        @if (!IsCollapsed)
                        {
                            <span class="footer-label signout-text">Sign out</span>
                        }
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@code {
    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback OnToggleCollapse { get; set; }

    [Parameter]
    public EventCallback<bool> OnThemeChanged { get; set; }

    private bool _isDark;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("ProcurePilotTheme.getTheme");
                _isDark = theme == "dark";
                StateHasChanged();
            }
            catch
            {
            }
        }
    }

    private async Task ToggleCollapse()
    {
        await OnToggleCollapse.InvokeAsync();
    }

    private async Task ToggleThemeAsync()
    {
        try
        {
            var next = await JS.InvokeAsync<string>("ProcurePilotTheme.toggleTheme");
            _isDark = next == "dark";
            await OnThemeChanged.InvokeAsync(_isDark);
        }
        catch
        {
            _isDark = !_isDark;
        }
    }
}
