@page "/exceptions/{ExceptionCaseId:guid}"
@using ProcurePilot.Application.Exceptions
@inject IExceptionWorkspaceQueries WorkspaceQueries
@inject IExceptionOverrideService OverrideService
@inject TimeProvider TimeProvider
@inject ILogger<ExceptionWorkspace> Logger

@attribute [Authorize(Policy = AuthorizationPolicies.ExceptionView)]

<PageTitle>@PageTitleText</PageTitle>

@if (_isLoading)
{
    <section class="exception-skeleton deferred-loading" role="status" aria-live="polite" aria-busy="true">
        <span class="visually-hidden">Loading exception workspace</span>
        <div></div><div></div><div></div><div></div>
    </section>
}
else if (_loadFailed)
{
    <SystemState Eyebrow="Exception workspace"
                 Marker="!"
                 Title="The exception could not be loaded"
                 Description="The read-only case context is temporarily unavailable. No financial data was changed."
                 Role="alert"
                 AriaLive="assertive">
        <Actions><a class="btn btn-outline-secondary" href="@CurrentUrl">Try again</a></Actions>
    </SystemState>
}
else if (_workspace is null)
{
    <SystemState Eyebrow="Exception workspace"
                 Marker="404"
                 Title="Exception not found"
                 Description="This case does not exist or is not available in your active tenant.">
        <Actions><a class="btn btn-outline-secondary" href="/work-queue">Return to work queue</a></Actions>
    </SystemState>
}
else
{
    <nav class="exception-breadcrumb" aria-label="Breadcrumb">
        <a href="/work-queue">Work queue</a><span aria-hidden="true">/</span><span aria-current="page">@CaseReference</span>
    </nav>

    <header class="exception-heading">
        <div>
            <p class="eyebrow">Exception workspace · controlled resolution</p>
            <h1>@CaseReference · @TypeLabel(_workspace.Type)</h1>
            <p class="page-summary">@_workspace.VendorName · @_workspace.InvoiceNumber · @_workspace.PurchaseOrderNumber</p>
        </div>
        <div class="exception-state" aria-label="Case state and priority">
            <span class="case-state">@StatusLabel(_workspace.Status)</span>
            <span class="case-priority priority-@_workspace.Severity.ToLowerInvariant()">@_workspace.Severity priority</span>
            <small>@AgeLabel</small>
        </div>
    </header>

    <ExceptionComparison Model="_workspace" />

    <section class="case-evidence" aria-labelledby="case-evidence-title">
        <div class="evidence-header">
            <p class="card-kicker">Audit trail</p>
            <h2 id="case-evidence-title">Factual evidence</h2>
            <p class="evidence-summary">Persisted match facts captured deterministically when price variance was evaluated.</p>
        </div>

        @if (_workspace.Evidences.Count == 0)
        {
            <div class="empty-evidence" role="status">
                No factual evidence records are available for this exception case.
            </div>
        }
        else
        {
            <div class="evidence-grid">
                @foreach (var evidence in _workspace.Evidences)
                {
                    <article class="evidence-card" aria-label="@evidence.Label">
                        <span class="evidence-type-badge">@evidence.Label</span>
                        <p class="evidence-value">@evidence.ValueText</p>
                        <dl class="evidence-meta">
                            <div>
                                <dt>Reference</dt>
                                <dd>@evidence.SourceReference</dd>
                            </div>
                            <div>
                                <dt>Captured</dt>
                                <dd><time datetime="@evidence.RecordedAtUtc.ToString("O")">@evidence.RecordedAtUtc.ToLocalTime().ToString("dd MMM yyyy · HH:mm")</time></dd>
                            </div>
                        </dl>
                    </article>
                }
            </div>
        }
    </section>

    <section class="case-context" aria-labelledby="case-context-title">
        <div>
            <p class="card-kicker">Case context</p>
            <h2 id="case-context-title">Operational facts</h2>
        </div>
        <dl>
            <div><dt>Owner</dt><dd>@(_workspace.AssignedToDisplayName ?? "Unassigned")</dd></div>
            <div><dt>Opened</dt><dd><time datetime="@_workspace.OpenedAtUtc.ToString("O")">@_workspace.OpenedAtUtc.ToLocalTime().ToString("dd MMM yyyy · HH:mm")</time></dd></div>
            <div><dt>Resolution</dt><dd>@ResolutionLabel</dd></div>
        </dl>
        <p>No automated approval or financial decision is available. Every override requires explicit permission, a human reason and an audit record.</p>
    </section>

    <AuthorizeView Policy="@AuthorizationPolicies.ExceptionOverride">
        <Authorized Context="overrideAuthorization">
            @if (CanOverride)
            {
                <section class="override-panel" aria-labelledby="override-title">
                    <div class="override-copy">
                        <p class="card-kicker">Controlled action</p>
                        <h2 id="override-title">Resolve with an override</h2>
                        <p>Use this only after reviewing the source evidence. Your reason and the state change will be recorded.</p>
                    </div>
                    <EditForm Model="_overrideInput" OnSubmit="SubmitOverrideAsync" FormName="exception-override">
                        <label for="override-reason">Override reason</label>
                        <InputTextArea id="override-reason"
                                       @bind-Value="_overrideInput.Reason"
                                       maxlength="1000"
                                       disabled="@_isSubmittingOverride"
                                       aria-describedby="override-guidance" />
                        <div class="override-footer">
                            <small id="override-guidance">Required · maximum 1,000 characters</small>
                            <button class="btn btn-primary"
                                    type="submit"
                                    disabled="@_isSubmittingOverride">
                                @(_isSubmittingOverride ? "Recording override…" : "Confirm override")
                            </button>
                        </div>
                    </EditForm>
                    @if (!string.IsNullOrWhiteSpace(_overrideMessage))
                    {
                        <p class="override-message @(_overrideSucceeded ? "success" : "error")"
                           role="@(_overrideSucceeded ? "status" : "alert")"
                           aria-live="polite">@_overrideMessage</p>
                    }
                </section>
            }
        </Authorized>
    </AuthorizeView>
}

@code {
    private ExceptionWorkspaceReadModel? _workspace;
    private bool _isLoading = true;
    private bool _loadFailed;
    private bool _isSubmittingOverride;
    private bool _overrideSucceeded;
    private string? _overrideMessage;
    private readonly OverrideInput _overrideInput = new();

    [Parameter]
    public Guid ExceptionCaseId { get; set; }

    private string CurrentUrl => $"/exceptions/{ExceptionCaseId}";
    private string PageTitleText => _workspace is null ? "Exception | ProcurePilot" : $"{CaseReference} | ProcurePilot";
    private string CaseReference => $"EXC-{ExceptionCaseId:N}"[..12].ToUpperInvariant();
    private string ResolutionLabel => _workspace?.ResolvedAtUtc is { } resolvedAt
        ? $"Resolved {resolvedAt.ToLocalTime():dd MMM yyyy · HH:mm}"
        : "Not resolved";
    private bool CanOverride => _workspace?.Status is "Open" or "WaitingAction" or "WaitingExternal";

    private string AgeLabel
    {
        get
        {
            var age = TimeProvider.GetUtcNow() - _workspace!.OpenedAtUtc;
            if (age < TimeSpan.Zero)
            {
                age = TimeSpan.Zero;
            }

            return age.TotalDays >= 1
                ? $"Open for {(int)age.TotalDays} day{(age.TotalDays >= 2 ? "s" : string.Empty)}"
                : age.TotalHours >= 1
                    ? $"Open for {(int)age.TotalHours} hour{(age.TotalHours >= 2 ? "s" : string.Empty)}"
                    : "Opened less than one hour ago";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _loadFailed = false;
        try
        {
            _workspace = await WorkspaceQueries.GetAsync(ExceptionCaseId);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load exception workspace {ExceptionCaseId}.", ExceptionCaseId);
            _workspace = null;
            _loadFailed = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SubmitOverrideAsync()
    {
        if (_workspace is null || _isSubmittingOverride)
        {
            return;
        }

        _isSubmittingOverride = true;
        _overrideMessage = null;
        _overrideSucceeded = false;
        try
        {
            var result = await OverrideService.OverrideAsync(
                new ExceptionOverrideCommand(_workspace.Id, _overrideInput.Reason));

            _overrideMessage = result.Outcome switch
            {
                ExceptionOverrideOutcome.Succeeded => "Override recorded. The exception is now resolved and auditable.",
                ExceptionOverrideOutcome.InvalidReason => "Enter a reason between 1 and 1,000 characters.",
                ExceptionOverrideOutcome.InvalidState => "This exception can no longer be overridden in its current state.",
                ExceptionOverrideOutcome.Forbidden => "You do not have permission to override this exception.",
                _ => "This exception is no longer available in your active tenant."
            };
            _overrideSucceeded = result.Outcome is ExceptionOverrideOutcome.Succeeded;

            if (_overrideSucceeded)
            {
                _overrideInput.Reason = string.Empty;
                _workspace = await WorkspaceQueries.GetAsync(ExceptionCaseId);
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to override exception {ExceptionCaseId}.", ExceptionCaseId);
            _overrideMessage = "The override could not be recorded. No partial change was accepted.";
        }
        finally
        {
            _isSubmittingOverride = false;
        }
    }

    private static string TypeLabel(string value) => value is "PriceVariance" ? "Price variance" : value;
    private static string StatusLabel(string value) => value switch
    {
        "WaitingAction" => "Waiting for action",
        "WaitingExternal" => "Waiting externally",
        _ => value
    };

    private sealed class OverrideInput
    {
        public string Reason { get; set; } = string.Empty;
    }
}
