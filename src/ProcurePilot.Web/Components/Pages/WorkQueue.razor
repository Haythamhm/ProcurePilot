@page "/work-queue"
@using System.Security.Claims
@using ProcurePilot.Application.Exceptions
@inject IExceptionWorkQueueQueries WorkQueueQueries
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<WorkQueue> Logger

@attribute [Authorize(Policy = AuthorizationPolicies.ActiveTenant)]

<PageTitle>Work Queue | ProcurePilot</PageTitle>

<header class="queue-heading">
    <div>
        <p class="eyebrow">Exception operations</p>
        <h1>Work Queue</h1>
        <p class="page-summary">Prioritize tenant-protected exception cases without losing their business context.</p>
    </div>
    @if (!_isLoading && !_loadFailed)
    {
        <div class="queue-count" aria-label="@CountLabel">
            <strong>@_items.Count</strong>
            <span>@FilterLabel</span>
        </div>
    }
</header>

<nav class="queue-filters" aria-label="Work queue views">
    @foreach (var filter in Filters)
    {
        <a href="@FilterUrl(filter.Value)" aria-current="@(filter.Value == _filter ? "page" : null)">
            <span>@filter.Label</span>
            <small>@filter.Description</small>
        </a>
    }
</nav>

@if (_isLoading)
{
    <div class="queue-state" role="status" aria-live="polite" aria-busy="true">
        <span class="queue-spinner" aria-hidden="true"></span>
        <div>
            <strong>Loading @FilterLabel.ToLowerInvariant()</strong>
            <p>Retrieving tenant-protected exception cases…</p>
        </div>
    </div>
}
else if (_loadFailed)
{
    <SystemState Eyebrow="Work queue"
                 Marker="!"
                 Title="The work queue is unavailable"
                 Description="Exception cases could not be loaded. No case was changed.">
        <Actions><a class="btn btn-outline-secondary" href="@FilterUrl(_filter)">Try again</a></Actions>
    </SystemState>
}
else if (_items.Count == 0)
{
    <SystemState Eyebrow="@FilterLabel"
                 Marker="✓"
                 Title="@EmptyTitle"
                 Description="@EmptyDescription" />
}
else
{
    <WorkQueueTable Items="_items"
                    Heading="@FilterLabel"
                    Caption="@TableCaption" />
}

@code {
    private static readonly QueueFilterOption[] Filters =
    [
        new(ExceptionWorkQueueFilter.Open, "Open", "Needs attention"),
        new(ExceptionWorkQueueFilter.Resolved, "Resolved", "Completed cases"),
        new(ExceptionWorkQueueFilter.AssignedToMe, "Assigned to me", "My active cases")
    ];

    private IReadOnlyList<ExceptionWorkQueueItem> _items = [];
    private ExceptionWorkQueueFilter _filter = ExceptionWorkQueueFilter.Open;
    private bool _isLoading = true;
    private bool _loadFailed;

    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    private string FilterLabel => Filters.Single(option => option.Value == _filter).Label;
    private string CountLabel => $"{_items.Count} cases in {FilterLabel.ToLowerInvariant()}";
    private string TableCaption => $"{FilterLabel} exception cases for the active tenant";
    private string EmptyTitle => _filter switch
    {
        ExceptionWorkQueueFilter.Open => "No open exceptions",
        ExceptionWorkQueueFilter.Resolved => "No resolved exceptions",
        ExceptionWorkQueueFilter.AssignedToMe => "No cases assigned to you",
        _ => "No exception cases"
    };
    private string EmptyDescription => _filter switch
    {
        ExceptionWorkQueueFilter.Open => "There are no exception cases requiring attention for this tenant.",
        ExceptionWorkQueueFilter.Resolved => "Resolved cases will appear here when work is completed.",
        ExceptionWorkQueueFilter.AssignedToMe => "Your active assigned cases will appear here.",
        _ => "There are no exception cases in this view."
    };

    protected override async Task OnParametersSetAsync()
    {
        _filter = ParseFilter(View);
        _isLoading = true;
        _loadFailed = false;

        try
        {
            Guid? currentUserId = null;
            if (_filter is ExceptionWorkQueueFilter.AssignedToMe)
            {
                var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var identifier = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);
                currentUserId = Guid.TryParse(identifier, out var userId)
                    ? userId
                    : throw new InvalidOperationException("The authenticated user identifier is unavailable.");
            }

            _items = await WorkQueueQueries.ListAsync(_filter, currentUserId);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load {Filter} exception cases for the active tenant.", _filter);
            _items = [];
            _loadFailed = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static ExceptionWorkQueueFilter ParseFilter(string? view) => view?.ToLowerInvariant() switch
    {
        "resolved" => ExceptionWorkQueueFilter.Resolved,
        "mine" => ExceptionWorkQueueFilter.AssignedToMe,
        _ => ExceptionWorkQueueFilter.Open
    };

    private static string FilterUrl(ExceptionWorkQueueFilter filter) => filter switch
    {
        ExceptionWorkQueueFilter.Open => "/work-queue?view=open",
        ExceptionWorkQueueFilter.Resolved => "/work-queue?view=resolved",
        ExceptionWorkQueueFilter.AssignedToMe => "/work-queue?view=mine",
        _ => "/work-queue"
    };

    private sealed record QueueFilterOption(
        ExceptionWorkQueueFilter Value,
        string Label,
        string Description);
}
