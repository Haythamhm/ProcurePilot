@page "/not-found"
@layout MainLayout

<PageTitle>Page not found | ProcurePilot</PageTitle>

<SystemState Eyebrow="Navigation"
             Marker="404"
             Title="Page not found"
             Description="The address may be incorrect, or this page may no longer be available in your workspace.">
    <Actions>
        <a class="btn btn-primary" href="/">
            <span class="pp-icon-home" aria-hidden="true"></span>
            Return to workspace
        </a>
    </Actions>
</SystemState>
