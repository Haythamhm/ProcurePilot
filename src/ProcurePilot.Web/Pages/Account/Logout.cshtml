@page "/account/logout"
@model ProcurePilot.Web.Pages.Account.LogoutModel
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign out - ProcurePilot</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <main class="container py-5" style="max-width: 32rem">
        <h1 class="mb-3">Sign out</h1>
        <p>Confirm that you want to end your ProcurePilot session.</p>
        <form method="post">
            <button type="submit" class="btn btn-primary">Sign out</button>
            <a href="/" class="btn btn-link">Cancel</a>
        </form>
    </main>
</body>
</html>
